---
import Base from '../../layouts/Base.astro';
import { allQuestions, topicByslug } from '../../lib/data';
import { S, SUBJ, PRACTICALS } from '../../lib/subject';
const prac = allQuestions.filter((q) => (q.features || []).includes('practical') && !q.notCurrentSpec);
const codes = {};
for (const q of prac) for (const s of q.skills || []) { if (!/^RP\d/.test(s.code)) continue; if (!codes[s.code]) codes[s.code] = { text: s.text, qs: [] }; codes[s.code].qs.push(q); }
const skillsOnly = prac.filter((q) => !(q.skills || []).some((s) => /^RP\d/.test(s.code)));
const list = PRACTICALS[SUBJ.sub];
const nTri = list.filter((p) => p.tri).length;
const ref = (q) => `${q.series.replace('June ', 'Jun ').replace('November ', 'Nov ')} ${q.paper.replace('Trilogy Paper ', 'Trilogy P').replace('Paper ', 'P')} Q${q.question}`;
---
<Base title={`AQA GCSE ${S} required practicals: all ${list.length}, with every past-paper question`} description={`The ${list.length} AQA GCSE ${S} required practicals (${nTri} of them in Combined Science): what each involves, what the written papers ask about it, and every past-paper question on it, with mark schemes.`} context="practicals" leadLine="At least 15% of the marks are on practical work. A tutor can take you through each required practical and the questions on it.">
  <h1>{S} required practicals</h1>
  <p>Separate GCSE {S} has {list.length} required practicals; {nTri} of them are also in Combined Science: Trilogy, where they have their own numbers. There is no practical exam: at least 15% of the marks on the written papers are on practical work, including these practicals. Below is what each one involves, what the papers ask about it, and every past-paper question on it. There are {prac.length} practical question parts in total; <a href="/questions/type/practical-questions/">see them all with their mark schemes</a>.</p>
  <div class="table-wrap"><table><thead><tr><th>Separate</th><th>Combined</th><th>Practical</th><th>What the papers ask</th><th>Questions</th></tr></thead>
  <tbody>{list.map((p) => <tr><td>{codes[p.code] ? <a href={`#${p.code}`}>{p.code}</a> : p.code}</td><td>{p.tri ? `RP${p.tri}` : 'Not in Combined'}</td><td>{p.name}</td><td>{p.asks}</td><td>{codes[p.code]?.qs.length || 0}</td></tr>)}</tbody></table></div>
  <p class="muted">Descriptions written by the site from the specification and the mark schemes; being checked by our tutor. Combined Science numbers its 21 practicals across all three sciences.</p>
  {list.filter((p) => codes[p.code]).map((p) => <section id={p.code}><h2>{p.code}: {p.name}</h2><p class="muted">{p.tri ? `Combined Science RP${p.tri}. ` : 'Separate ' + S + ' only. '}{codes[p.code].text}</p>
    <ul class="qlinks">{codes[p.code].qs.sort((a, b) => b.year - a.year).map((q) => <li><a href={`/questions/${q.topics[0]}/#${q.id}`}>{ref(q)}</a> <span class="muted">{q.marks} mark{q.marks === 1 ? '' : 's'} · {topicByslug.get(q.topics[0])?.name}</span></li>)}</ul></section>)}
  <section id="skills"><h2>Planning, analysis and evaluation</h2><p class="muted">Questions on variables, method, measurements, tables, graphs and improvements that are not tied to one required practical.</p>
    <details class="spec-fold"><summary>{skillsOnly.length} questions</summary><ul class="qlinks">{skillsOnly.sort((a, b) => b.year - a.year).map((q) => <li><a href={`/questions/${q.topics[0]}/#${q.id}`}>{ref(q)}</a> <span class="muted">{q.marks} mark{q.marks === 1 ? '' : 's'} · {topicByslug.get(q.topics[0])?.name}</span></li>)}</ul></details></section>
</Base>
