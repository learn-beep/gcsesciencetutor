---
import { S } from '../../lib/subject';
import Base from '../../layouts/Base.astro';
import Heatmap from '../../components/Heatmap.astro';
import weighting from '../../data/weighting.json';
import { allPapers } from '../../lib/data';
const areas = Object.entries(weighting.areas);
const series = [...new Set(allPapers.filter((p) => p.kind === 'exam').map((p) => p.series))].reverse();
const marksFor = (qual) => (s, area) => allPapers.filter((p) => p.qual === qual && p.series === s).reduce((n, p) => n + (weighting.byPaper[p.id]?.[area] || 0), 0);
const triAreas = areas.filter(([k]) => series.some((s) => marksFor('Trilogy')(s, k)));
---
<Base title={`What comes up in AQA GCSE ${S}: marks by topic, 2018–2025`} context="analysis">
  <h1>What comes up, paper by paper</h1>
  <p>Marks assessed under each part of the specification in each series, from our tagging of every question part. Darker cells carry more marks; the right-hand column is the total since June 2018. A part that assesses two areas counts its marks under both, so a column can add up to more than the marks on the papers.</p>
  <h2>Separate {S} (Papers 1 and 2, 200 marks)</h2>
  <Heatmap areas={areas} series={series} value={marksFor('Separate')} title="Marks by area by series, separate papers" short={(s) => s.replace('June ', 'Jun ').replace('November ', 'Nov ').replace(' 20', ' ')} />
  <h2>Combined Science {S} (Trilogy Papers 1 and 2, 140 marks)</h2>
  <Heatmap areas={triAreas} series={series} value={marksFor('Trilogy')} title="Marks by area by series, Combined Science papers" short={(s) => s.replace('June ', 'Jun ').replace('November ', 'Nov ').replace(' 20', ' ')} />
  <p class="muted">June 2025 is the most recent series AQA has published. AQA keeps each summer's papers for teachers only for about a year, so the data here runs to the latest public series. November 2020 and November 2021 were the autumn series sat in place of the cancelled summer exams.</p>
  <p><a href="/what-came-up/">What came up in the latest papers</a> · <a href="/timeline/">Every paper as a timeline</a></p>
</Base>
