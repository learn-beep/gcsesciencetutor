---
import Base from '../../layouts/Base.astro';
import tutors from '../../data/tutors.json';
const tutor = tutors[0];
const title = tutor ? `GCSE science tutor online: ${tutor.name}, one-to-one Biology, Chemistry and Physics` : 'GCSE science tutor: online one-to-one lessons';
const desc = tutor ? tutor.bio[0] : 'Online one-to-one GCSE and IGCSE science tutoring from an experienced, qualified teacher. Paid trial lesson, no packages, lesson by lesson.';
---
<Base title={title} description={desc} context="tutors" leadLine="Tell us the year group, the course, the target grade and your availability, and we will arrange a trial lesson.">
  {tutor ? <>
    <div class="tutor-head">
      {tutor.photo ? <img class="tutor-photo" src={tutor.photo} alt={tutor.name} width="160" height="160" /> : <div class="tutor-photo tutor-initial" aria-hidden="true">{tutor.name[0]}</div>}
      <div><h1>Your tutor: {tutor.name}</h1><p class="muted">{tutor.title}</p></div>
    </div>
    {tutor.bio.map((p) => <p>{p}</p>)}
    <h2>What {tutor.name} offers</h2>
    <ul>{tutor.offers.map((o) => <li>{o}</li>)}</ul>
  </> : <>
    <h1>Your GCSE science tutor</h1>
    <p>Online one-to-one lessons for GCSE and IGCSE Biology, Chemistry, Physics and Combined Science, from an experienced, qualified teacher.</p>
  </>}
  <h2>Fees and how it works</h2>
  <ul>
    <li><strong>{tutor?.fee || 'Fee on enquiry'}</strong>, online, one-to-one. The first lesson is a paid trial{tutor?.fee ? ' at the same rate' : ''}; if it isn't right for you there is no obligation to continue.</li>
    <li>No packages and nothing to buy in advance: you pay lesson by lesson.</li>
    <li>Most students have one lesson a week at a regular slot through Year 10 and Year 11, which is what moves a grade.</li>
    <li>All lessons are online.</li>
  </ul>
  <ol>
    <li>Message us on WhatsApp or send the enquiry form with the year group, the course and exam board, the target grade and the times that work for you.</li>
    <li>{tutor ? tutor.name : 'The tutor'} gets in touch to arrange the trial lesson.</li>
    <li>Lessons are booked directly with {tutor ? 'him' : 'the tutor'} from then on.</li>
  </ol>
  {tutor?.reviews?.length > 0 && <>
    <h2>What students say</h2>
    {tutor.reviews.map((r) => <blockquote class="review"><p>{r.text}</p><footer>{'★'.repeat(r.stars)} {r.who}, {r.when}</footer></blockquote>)}
    <p class="muted">{tutor.reviewSource}.</p>
  </>}
</Base>
