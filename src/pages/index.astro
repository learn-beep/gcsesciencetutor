---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers } from '../lib/data';
import Icon from '../components/Icon.astro';
import { badgeClass, badgeText } from '../lib/groups';
import { IS_HOME, S, SUBJ, SUBJECTS, AQA_SEP } from '../lib/subject';
import home from '../data/home.json';
import tutors from '../data/tutors.json';
const top = [...allTopics].filter((t) => !t.option).sort((a, b) => b.parts - a.parts).slice(0, 16);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, parts: t.parts }));
const current = allQuestions.filter((q) => !q.notCurrentSpec).length;
const latest = allPapers.filter((p) => p.kind === 'exam').map((p) => p.series).sort((a, b) => Number(b.split(' ')[1]) - Number(a.split(' ')[1]))[0];
const H: any = home;
const total = Object.values(H).reduce((n: number, x: any) => n + x.parts, 0);
const dates = SUBJECTS.flatMap((x) => H[x.sub].exams.map((e: any) => ({ ...e, sub: x.name }))).sort((a: any, b: any) => a.date.localeCompare(b.date));
const fmtDate = (d: string) => new Date(d + 'T09:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long' });
const sepOnly = allTopics.filter((t: any) => !(t.asStatements || []).length).length;
const sam = (tutors as any[])[0];
---
{IS_HOME ? (
<Base title="GCSE Science past-paper questions by topic: AQA Biology, Chemistry and Physics" context="home" leadLine="Not sure where to start? Tell us the year group, the course and the target grade and we will arrange a trial lesson with Sam.">
  <h1>GCSE Science past-paper questions, one topic at a time</h1>
  <p>{total.toLocaleString()} question parts from every AQA GCSE Biology, Chemistry and Physics higher-tier paper since 2018, for separate sciences and Combined Science: Trilogy, sorted by topic, with the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>

  <div class="tiles">
    {SUBJECTS.map((x) => <a class="tile-card" href={`/${x.sub}/`}><Icon name="book" /><strong>{x.name}</strong><span>{H[x.sub].parts.toLocaleString()} question parts from {H[x.sub].papers} papers, in {H[x.sub].topics} topics. GCSE {x.name} ({x.code}) and the {x.name} papers of Combined Science (8464).</span></a>)}
  </div>

  <h2>Separate sciences or Combined Science?</h2>
  <p>Most students take <strong>Combined Science: Trilogy</strong> (8464): six papers, two each in biology, chemistry and physics, each 1 hour 15 minutes and 70 marks, giving two grades from 9-9 down to 1-1. Students taking <strong>separate sciences</strong> (triple science) sit GCSE Biology (8461), Chemistry (8462) and Physics (8463): two papers in each, 1 hour 45 minutes and 100 marks, and a grade for each subject.</p>
  <p>The separate papers cover everything in Combined Science plus some extra content. On every topic page here, questions are labelled <strong>Combined</strong> (from a Trilogy paper) or <strong>Separate</strong> (from a GCSE Biology, Chemistry or Physics paper), and topics that are only in the separate sciences say so. Combined Science students can use the separate-paper questions on shared topics too: the content is the same.</p>

  <h2>Summer 2027 exam dates</h2>
  <div class="table-wrap"><table><thead><tr><th>Date</th><th>Paper</th><th>Length</th></tr></thead>
  <tbody>{dates.map((e: any) => <tr><td>{fmtDate(e.date)}</td><td>{e.name} <span class="muted">({e.code})</span></td><td>{e.length}</td></tr>)}</tbody></table></div>
  <p class="muted">From AQA's final timetable for May/June 2027. All are morning exams. Check with your school, which may enter you for a different tier.</p>

  <h2>Your tutor</h2>
  <div class="tiles">
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Sam</strong><span>{sam ? sam.title : 'An experienced science teacher'}. Online one-to-one lessons for GCSE and IGCSE science.</span></a>
  </div>
</Base>
) : (
<Base title={`AQA GCSE ${S}: past-paper questions by topic, mark schemes and a tutor`} context="home" leadLine="Not sure where to start? Tell us the year group, the course and the target grade and we will arrange a trial lesson with Sam.">
  <h1>AQA GCSE {S}, one topic at a time</h1>
  <p>{current.toLocaleString()} question parts from {allPapers.length} AQA higher-tier papers from 2018 to {latest}, sorted by topic, with the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>
  <p class="muted">GCSE {S} ({SUBJ.code}) Papers 1 and 2, and the {S} papers of Combined Science: Trilogy (8464). Paper 1 covers sections {SUBJ.p1} and Paper 2 sections {SUBJ.p2} of the specification. {sepOnly} of the {allTopics.length} topics are in separate {S} only. The June 2026 papers will be added when AQA makes them public.</p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    {SUBJ.sub === 'physics' ? <a href="/equations/"><Icon name="book" />Equations</a> : <a href="/six-mark-questions/"><Icon name="layers" />Six-markers</a>}
    <a href="/maths-skills/"><Icon name="calculator" />Maths skills</a>
    <a href="/required-practicals/"><Icon name="checklist" />Practicals</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder="Type a topic" autocomplete="off" />

  <h2 class="strand-head">Most-examined topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand"><span class={badgeClass(t.group)}>{badgeText(t.group)}</span> {t.parts} parts</span></a></li>)}
  </ul>
  <p><a href="/questions/">All {allTopics.length} topics</a></p>

  <h2>Everything for GCSE {S}</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every higher-tier {SUBJ.code} and Trilogy {S} paper since 2018, question by question, with mark schemes and examiners' comments</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time, filtered by topic and by Combined or Separate, marked against the mark scheme</span></a>
    {SUBJ.sub === 'physics' && <a class="tile-card" href="/equations/"><Icon name="book" /><strong>Equations</strong><span>The equations you must learn and the ones AQA gives you, with the separate-only and higher-tier ones marked</span></a>}
    <a class="tile-card" href="/maths-skills/"><Icon name="calculator" /><strong>Maths skills</strong><span>Every question that tests a maths skill from the specification, sorted by skill</span></a>
    <a class="tile-card" href="/required-practicals/"><Icon name="checklist" /><strong>Required practicals</strong><span>What the papers ask about each practical, which are in Combined Science, and every question on them</span></a>
    <a class="tile-card" href="/six-mark-questions/"><Icon name="layers" /><strong>Six-mark questions</strong><span>Every extended response question, by topic, with a timed practice tool</span></a>
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mini-mock builder</strong><span>A timed mock from real questions, shaped like a separate or a Combined Science paper</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Spec checklist</strong><span>Every statement of the specification, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks by topic since 2018, the latest papers, every paper as a timeline</span></a>
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Boundaries and dates</strong><span>Grade calculators for separate {S} and Combined Science, and the 2027 exam dates</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Your tutor</strong><span>Online one-to-one lessons with Sam, an experienced science teacher</span></a>
  </div>

  <script define:vars={{ topics }}>
    try {
      const ticks = JSON.parse(localStorage.getItem('gcsesci-spec') || '{}'), scores = JSON.parse(localStorage.getItem('gcsesci-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name.split(':')[0]}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} parts</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. <a href="/questions/">Browse all topics</a>.</li>';
    });
  </script>
</Base>
)}
