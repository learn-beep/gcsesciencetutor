---
import { S, SUBJ } from '../../lib/subject';
import Base from '../../layouts/Base.astro';
import Hint from '../../components/Hint.astro';
import spec from '../../data/spec.json';
const sections = spec.filter((s) => s.statements.length);
const total = sections.reduce((n, s) => n + s.statements.length, 0);
import { GROUPS } from '../../lib/groups';
const papers = GROUPS.map((g) => [g.sec, g.heading]);
const triN = sections.reduce((n, s) => n + s.statements.filter((st) => st.as).length, 0);
---
<Base title={`AQA GCSE ${S} specification checklist (${SUBJ.code}): all ${total} statements, tickable`} description={`All ${total} content statements of the AQA GCSE ${S} specification (${SUBJ.code}) as a tickable checklist, with the statements that are not in Combined Science marked and links to the past-paper questions for each topic.`} context="specification" leadLine="Big gaps on the checklist? A tutor can plan the order to close them.">
  <h1>Specification checklist</h1>
  <p>Every content statement in the AQA GCSE {S} specification ({SUBJ.code}), under AQA's section numbers; we number the statements within each subsection (4.1.1.2-03 is the third statement of 4.1.1.2). {triN} of the {total} are also in Combined Science: Trilogy; the rest are marked <em>separate only</em>. Higher-tier-only content is included. Paper 1 covers sections {SUBJ.p1} and Paper 2 sections {SUBJ.p2}. Tick what you're confident with; ticks are saved in this browser only.</p>
  <Hint id="ticks" text="Ticks are saved in this browser only. The revision planner uses them to pick your weak topics." />
  <p class="muted"><span id="done">0</span> of {total} ticked · <button class="chip" type="button" id="clear">Clear my ticks</button></p>
  {papers.map(([n, h]) => (
    <>
      <h2 class="strand-head">{h}</h2>
      {sections.filter((s) => s.code.startsWith(n + '.')).map((s) => (
        <section>
          <h3>{s.code} {s.title} <span class="muted small-text">{s.area}</span> {s.topic && <a class="small-text" href={`/questions/${s.topic}/`}>questions</a>}</h3>
          <ul class="spec-list">
            {s.statements.map((st) => (
              <li><label><input type="checkbox" data-spec={st.id} /><span><strong>{st.id}</strong> {!st.as && <span class="pill pill-hard">Separate only</span>} {st.text}{st.guidance && <><br /><span class="muted small-text">{st.guidance}</span></>}</span></label></li>
            ))}
          </ul>
        </section>
      ))}
    </>
  ))}
  <script>
    const KEY = 'gcsesci-spec';
    const boxes = document.querySelectorAll('input[data-spec]');
    const done = document.getElementById('done');
    let state = {};
    try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    const paint = () => { let n = 0; boxes.forEach((b) => { b.checked = !!state[b.dataset.spec]; if (b.checked) n++; }); done.textContent = String(n); };
    boxes.forEach((b) => b.addEventListener('change', () => { state[b.dataset.spec] = b.checked; try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} paint(); }));
    document.getElementById('clear').addEventListener('click', () => { state = {}; try { localStorage.removeItem(KEY); } catch {} paint(); });
    paint();
  </script>
</Base>
