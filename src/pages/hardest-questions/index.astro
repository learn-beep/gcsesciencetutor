---
import { S } from '../../lib/subject';
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import { allQuestions } from '../../lib/data';
const hard = allQuestions.filter((q) => q.difficulty === 'Hard' && !q.notCurrentSpec).sort((a, b) => (a.facility ?? 1) - (b.facility ?? 1));
---
<Base title={`Hardest AQA GCSE ${S} questions (from the examiners' own figures)`} context="hardest" leadLine="Want to work through the hard ones with a tutor? Message us.">
  <h1>The hardest AQA GCSE {S} questions</h1>
  <p>AQA's examiner reports often give the proportion of students who scored the marks on a question. These are the {hard.length} parts where under 35% scored all the marks, with the examiner's comment on where answers fell short.</p>
  {hard.map((q) => <QuestionCard q={q} showTopics={true} />)}
</Base>
