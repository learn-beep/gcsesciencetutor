---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { S, SUBJ } from '../../lib/subject';
---
<Base title={`AQA GCSE ${S} mini-mock builder: timed papers from real questions`} description={`Build a timed mini-mock from real AQA GCSE ${S} questions in the shape of separate ${S} Paper 1 or 2, or the Combined Science ${S} papers. Play it on screen or print it with the mark schemes.`} context="mock" leadLine="Want a mock marked properly and gone through? Message us.">
  <h1>Mini-mock builder</h1>
  <p>Assembles a paper from real AQA higher-tier questions in the shape of the exam. Separate {S} papers are 100 marks in 1 hour 45 minutes; the Combined Science: Trilogy {S} papers are 70 marks in 1 hour 15 minutes. Paper 1 covers sections {SUBJ.p1} of the specification and Paper 2 sections {SUBJ.p2}. Questions are kept whole, so every part has the information it needs.</p>
  <div class="panel" id="setup">
    <h3>Course</h3>
    <div class="chips" data-group="course"><button class="chip" type="button" data-v="Trilogy" aria-pressed="true">Combined Science</button><button class="chip" type="button" data-v="Separate">Separate {S}</button></div>
    <h3>Paper</h3>
    <div class="chips" data-group="paper"><button class="chip" type="button" data-v="1" aria-pressed="true">Paper 1 ({SUBJ.p1})</button><button class="chip" type="button" data-v="2">Paper 2 ({SUBJ.p2})</button></div>
    <h3>Length</h3>
    <div class="chips" data-group="part"><button class="chip" type="button" data-v="B" aria-pressed="true">About 30 marks</button><button class="chip" type="button" data-v="full">Full paper</button></div>
    <p class="muted" id="shape"></p>
    <div><button class="btn btn-accent" type="button" id="build">Build my mock</button></div>
  </div>
  <div id="paper" hidden>
    <div class="playbar"><span id="title"></span><span class="timer" id="timer"></span><span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start timer</button> <button class="btn" type="button" id="print"><Icon name="printer" />Print</button> <button class="btn" type="button" id="share"><Icon name="link" />Copy link</button></span></div>
    <div id="cards"></div>
    <div class="btn-row"><button class="btn btn-accent" type="button" id="rebuild">Build another</button></div>
  </div>
  <script>
    import { loadBank, card, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = { course: 'Trilogy', paper: '1', part: 'B' };
    let bank = null, timer = null, secs = 0;
    // [full-paper marks, seconds per mark]
    const SHAPE = { Separate: [100, 63], Trilogy: [70, 64] };
    const target = () => (sel.part === 'full' ? SHAPE[sel.course][0] : 30);
    const pname = () => (sel.course === 'Trilogy' ? 'Trilogy Paper ' : 'Paper ') + sel.paper;
    function shape() {
      const [full, spm] = SHAPE[sel.course]; const t = target();
      $('#shape').textContent = sel.part === 'full' ? `Whole questions adding up to about ${full} marks (${sel.course === 'Trilogy' ? '1 hour 15 minutes' : '1 hour 45 minutes'}).` : `Whole questions adding up to about ${t} marks (about ${Math.round(t * spm / 60)} minutes).`;
    }
    document.querySelectorAll('[data-group]').forEach((g) => g.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => { g.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); sel[g.dataset.group] = b.dataset.v; shape(); })));
    shape();
    loadBank().then((b) => { bank = b; });
    const groupsOf = (qs) => { const m = new Map(); for (const q of qs) { if (!m.has(q.g)) m.set(q.g, []); m.get(q.g).push(q); } return [...m.values()]; };
    const marksOf = (g) => g.reduce((a, q) => a + q.m, 0);
    function fill(groups, target) {
      // whole questions up to the target: take any that fit, then stop near the target
      const out = []; let total = 0;
      for (const g of groups) { const m = marksOf(g); if (total + m <= target + 2) { out.push(g); total += m; } if (total >= target - 2) break; }
      return out;
    }
    $('#build').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => !q.old && q.c && q.p === pname());
      const groups = shuffle(groupsOf(pool));
      let picked = [];
      const add = (g) => { picked = picked.concat(g.slice().sort((a, b) => a.q.localeCompare(b.q, undefined, { numeric: true }))); };
      fill(groups, target()).forEach(add);
      if (!picked.length) { $('#shape').textContent = 'Nothing matched; try another combination.'; return; }
      const total = picked.reduce((a, q) => a + q.m, 0);
      $('#setup').hidden = true; $('#paper').hidden = false;
      $('#title').textContent = `${sel.course === 'Trilogy' ? 'Combined Science' : 'Separate'} Paper ${sel.paper}: ${picked.length} parts, ${total} marks`;
      secs = Math.round(total * SHAPE[sel.course][1]); $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      renderPicked(picked);
      location.hash = 'set=' + picked.map((q) => q.id).join(',');
      window.scrollTo({ top: 0 });
    });
    function renderPicked(picked) { const holder = $('#cards'); holder.innerHTML = ''; let lastG = null; picked.forEach((q, n) => { const c = card(q, { mcq: true }); c.querySelector('.meta strong').textContent = `Part ${n + 1} (from ${q.s} ${q.p} Q${q.q})`; if (q.g === lastG) { const st = c.querySelector('details.stem'); if (st) st.remove(); } lastG = q.g; holder.appendChild(c); }); }
    $('#share').addEventListener('click', async () => { const url = location.href.split('#')[0] + location.hash; try { await navigator.clipboard.writeText(url); window.gcseToast && window.gcseToast('Link copied'); } catch { prompt('Copy this link', url); } });
    loadBank().then(() => { const m = location.hash.match(/set=([^&]+)/); if (!m || !bank) return; const ids = decodeURIComponent(m[1]).split(','); const picked = ids.map((id) => bank.q.find((q) => q.id === id)).filter(Boolean); if (!picked.length) return; const total = picked.reduce((a, q) => a + q.m, 0); $('#setup').hidden = true; $('#paper').hidden = false; $('#title').textContent = `Shared mock: ${picked.length} parts, ${total} marks`; secs = Math.round(total * 64); $('#timer').textContent = fmtTime(secs); renderPicked(picked); });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    $('#print').addEventListener('click', () => { document.querySelectorAll('#cards img[data-src]').forEach((img) => { img.src = img.dataset.src; img.removeAttribute('data-src'); }); document.querySelectorAll('#cards details.stem').forEach((d) => { d.open = true; }); setTimeout(() => window.print(), 300); });
    $('#rebuild').addEventListener('click', () => { if (timer) clearInterval(timer); $('#paper').hidden = true; $('#setup').hidden = false; window.scrollTo({ top: 0 }); });
  </script>
</Base>
