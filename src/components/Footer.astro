---
import site from '../data/site.json';
import family from '../data/family.json';
const sisters = family.filter((f) => !f.url.includes('sciencegcsetutor.com'));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div>{site.spec}</div>
    <div>Past-paper questions, mark schemes and examiner reports are © AQA and are shown free for study. <a href="/about/">About this site</a></div>
    <div><a href="/biology/">Biology</a> · <a href="/chemistry/">Chemistry</a> · <a href="/physics/">Physics</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/report/">Report a mistake</a></div>
    <div>Part of <a href="https://www.aleveltutors.online/">aleveltutors.online</a>, online tutors for GCSE and A-level · <a href="https://www.aleveltutors.online/online-gcse-biology-tutor/">Find a GCSE Science tutor</a></div>
    <div>Free revision sites for other subjects: {sisters.map((f, i) => <>{i > 0 && ' · '}<a href={f.url}>{f.gcse ? f.name : `A-level ${f.name}`}</a></>)}</div>
    <div>© {year} {site.company} · Company no. {site.companyNumber}, registered in England and Wales · <a href={`mailto:${site.email}`}>{site.email}</a></div>
  </div>
</footer>
